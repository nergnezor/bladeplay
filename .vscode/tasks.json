{
	"version": "2.0.0",
	"tasks": [
		{
			"type": "cargo",
			"command": "build",
			"args": ["--workspace"],
			"problemMatcher": ["$rustc"],
			"label": "cargo build",
			"group": {
				"kind": "build",
				"isDefault": true
			}
		},
		{
			"type": "shell",
			"label": "watch interact-logic",
			"command": "cargo watch -w interact-logic/src -x 'build -p interact-logic'",
			"isBackground": true,
			"problemMatcher": {
				"pattern": {
					"regexp": "^error",
					"file": 1,
					"line": 2,
					"message": 3
				},
				"background": {
					"activeOnStart": true,
					"beginsPattern": "^\\[Running",
					"endsPattern": "^\\[Finished"
				}
			}
		},
		{
			"label": "Build Android (aarch64)",
			"type": "shell",
			"command": "cargo build -p interact --target aarch64-linux-android",
			"options": {
				"cwd": "${workspaceFolder}",
				"env": {
					"ANDROID_HOME": "/usr/lib/android-sdk",
					"ANDROID_SDK_ROOT": "/usr/lib/android-sdk",
					"ANDROID_NDK_ROOT": "/usr/lib/android-sdk/ndk/27.2.12479018",
					"PATH": "/usr/lib/android-sdk/platform-tools:${env:PATH}"
				}
			},
			"group": {
				"kind": "build",
				"isDefault": false
			},
			"problemMatcher": []
		}
	]
}
